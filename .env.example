# Public Supabase URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable key. This is safe to expose to browser code when RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used by Auth, transactional links and notification email.
NEXT_PUBLIC_SITE_URL=

# Set to true only after Google is configured in the Supabase Auth provider settings.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# Public VAPID application-server key used only when a user explicitly enables push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only privileged key. Never expose this through NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side VAPID credentials. VAPID_PUBLIC_KEY must match NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Transactional email provider credentials.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Changas <notificaciones@example.com>

# Bearer secret required by the internal notification dispatch endpoint.
NOTIFICATION_DISPATCH_SECRET=
