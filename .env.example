# Public Supabase URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable key. This is safe to expose to browser code when RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public origin used by Auth callback and recovery links.
NEXT_PUBLIC_SITE_URL=

# Set to true only after Google is configured in the Supabase Auth provider settings.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# Server-only privileged key. Never expose this through NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=
