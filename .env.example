# Public Supabase URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable key. This is safe to expose to browser code when RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Never expose this through NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=
