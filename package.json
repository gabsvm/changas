{
  "name": "changas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @changas/web dev",
    "build": "pnpm --filter @changas/web build",
    "lint": "pnpm --filter @changas/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "prettier --write apps/web/src/lib/payments/server.ts apps/web/src/components/payments/provider-payment-account.tsx && git diff -- apps/web/src/lib/payments/server.ts apps/web/src/components/payments/provider-payment-account.tsx && exit 1",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "vitest": "4.1.11"
  }
}
